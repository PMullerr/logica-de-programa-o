#variaveis
produto = "camisa"
preço = 120
quantidade = 25
custo_unitario = 75
percentual_desconto = 5
cliente_ativo = True

#processos
total_venda = preço * quantidade
valor_desconto = total_venda * (percentual_desconto / 100)
valor_final = total_venda - valor_desconto
custo_total = custo_unitario * quantidade
lucro = valor_final - custo_total

#saidas
print(produto)
print(preço)
print(quantidade)
print(cliente_ativo)
